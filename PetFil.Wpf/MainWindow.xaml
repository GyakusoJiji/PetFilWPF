<Window x:Class="PetFil.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PET フィラメントメーカー" Height="660" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" VerticalAlignment="Top" Grid.Row="0" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">ポート:</TextBlock>
            <ComboBox x:Name="PortCombo" Width="200" Margin="0,0,10,0"/>
            <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">ボーレート:</TextBlock>
            <ComboBox x:Name="BaudCombo" Width="100" Margin="0,0,10,0"/>
            <Button x:Name="ConnectButton" Content="接続" Width="90" Click="ConnectButton_Click"/>
            <Button x:Name="RescanButton" Content="再スキャン" Width="90" Margin="6,0,0,0" Click="RescanButton_Click"/>
            <Button x:Name="ResetButton" Content="リセット" Width="90" Margin="6,0,0,0" Click="ResetButton_Click"/>
            <Button x:Name="EmergencyStopButton" Content="非常停止" Width="110" Margin="24,0,0,0"
                    Background="#C62828" Foreground="White" FontWeight="Bold"
                    Click="EmergencyStopButton_Click"
                    MouseRightButtonUp="EmergencyStopButton_RightClick">
                <Button.ToolTip>
                    クリック: 巻き取りを止め、送信待ちの移動を破棄してヒーターを OFF&#x0a;右クリック: M112 でファームウェアごと停止（復帰にはリセットが必要）
                </Button.ToolTip>
            </Button>
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left column: controls -->
            <StackPanel Grid.Column="0">
                <TextBlock FontWeight="Bold" Margin="0,0,0,6">ノズル温度</TextBlock>
                <TextBlock x:Name="TempLabel" FontWeight="Bold" FontSize="20" Margin="0,0,0,6">--- / --- °C</TextBlock>

                <Border BorderBrush="Gray" BorderThickness="1" Height="140" Margin="0,0,0,6">
                    <Canvas x:Name="TempGraphCanvas" Background="#FAFAC7" ClipToBounds="True">
                        <Polyline x:Name="TempPolyline" Stroke="#0005FF" StrokeThickness="2"/>
                        <Polyline x:Name="TempTargetPolyline" Stroke="#FF7800" StrokeThickness="1" StrokeDashArray="4 2"/>
                    </Canvas>
                </Border>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">目標:</TextBlock>
                    <TextBox x:Name="TempTextBox" Width="60" VerticalContentAlignment="Center"
                             TextChanged="TempTextBox_TextChanged"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,6,0">°C</TextBlock>
                    <Button Content="設定" Width="60" Margin="0,0,6,0" Click="SetTempButton_Click" />
                    <Button Content="オフ" Width="60" Click="HeaterOffButton_Click" />
                </StackPanel>
                <Slider x:Name="TempSlider" Minimum="0" Maximum="300" TickFrequency="10"
                        ValueChanged="TempSlider_ValueChanged" Margin="0,0,0,12"/>

                <TextBlock FontWeight="Bold" Margin="0,0,0,6">巻き取り（X軸）</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Margin="0,0,6,0">速度:</TextBlock>
                    <TextBox x:Name="SpeedTextBox" Width="60" VerticalContentAlignment="Center"
                             TextChanged="SpeedTextBox_TextChanged"/>
                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0">mm/min</TextBlock>
                </StackPanel>
                <Slider x:Name="SpeedSlider" Minimum="0" Maximum="400" TickFrequency="10"
                        ValueChanged="SpeedSlider_ValueChanged" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="StartWinderButton" Content="運転開始" Width="80" Click="StartWinderButton_Click" />
                    <Button x:Name="StopWinderButton" Content="停止" Width="80" Margin="6,0,0,0" Click="StopWinderButton_Click" />
                </StackPanel>
                <TextBlock Margin="0,0,0,4" Foreground="Gray">押している間だけ設定速度の10倍で回します</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                    <Button x:Name="JogForwardButton" Content="正転 ×10" Width="80"
                            PreviewMouseLeftButtonDown="JogForwardButton_MouseDown"
                            LostMouseCapture="JogButton_LostMouseCapture" />
                    <Button x:Name="JogReverseButton" Content="逆転 ×10" Width="80" Margin="6,0,0,0"
                            PreviewMouseLeftButtonDown="JogReverseButton_MouseDown"
                            LostMouseCapture="JogButton_LostMouseCapture" />
                </StackPanel>
                <TextBlock x:Name="WinderLabel">停止中　積算 0.0 mm</TextBlock>

                <TextBlock FontWeight="Bold" Margin="0,12,0,6">運転条件</TextBlock>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="SaveSettingsButton" Content="保存" Width="80" Click="SaveSettingsButton_Click" />
                    <Button x:Name="LoadSettingsButton" Content="呼び出し" Width="80" Margin="6,0,0,0" Click="LoadSettingsButton_Click" />
                    <TextBlock x:Name="SavedPresetLabel" VerticalAlignment="Center" Margin="10,0,0,0" Foreground="Gray" />
                </StackPanel>
                <TextBlock Foreground="Gray" Margin="0,0,0,0">呼び出しは欄に入れるだけです。温度は「設定」で反映してください</TextBlock>

                <TextBlock FontWeight="Bold" Margin="0,12,0,6">コマンド</TextBlock>
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="CommandBox" Width="220" />
                    <Button Content="送信" Width="60" Margin="6,0,0,0" Click="SendCommandButton_Click" />
                </StackPanel>
            </StackPanel>


            <!-- Right column: log -->
            <TextBox Grid.Column="2" x:Name="LogBox" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AcceptsReturn="True"/>
        </Grid>
    </Grid>
</Window>
